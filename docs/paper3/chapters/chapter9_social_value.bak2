		\fill[green!15,rounded corners=4pt] (9.2,0.6) rectangle (13.8,3.8);
		\draw[green!60!black,line width=1pt,rounded corners=4pt] (9.2,0.6) rectangle (13.8,3.8);
		\node[font=\small\bfseries,green!50!black] at (11.5,3.4) {长期：平台壁垒};
		\node[align=center,font=\footnotesize,text width=4.2cm] at (11.5,2.2) {
