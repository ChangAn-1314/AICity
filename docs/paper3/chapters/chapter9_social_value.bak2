		\fill[accentgold!18,rounded corners=4pt] (4.2,0.6) rectangle (9,3.8);
		\draw[accentgold!80,line width=1pt,rounded corners=4pt] (4.2,0.6) rectangle (9,3.8);
		\node[font=\small\bfseries,accentgold!90!black] at (6.6,3.4) {中期：区域复制};
