\section{调研与访谈模板}

\begin{table}[H]
	\centering
	\caption{调研与访谈模板}
	\begin{tabularx}{\textwidth}{L{3.2cm}Y}
		\toprule
		模板名称    & 字段说明                                \\
		\midrule
		问卷样本统计表 & 样本编号、对象类型、所属行业或单位、核心痛点、预算敏感度、是否愿意试点 \\
		访谈对象摘要表 & 访谈编号、访谈对象身份、关注问题、关键原话、结论摘要、可信度备注    \\
		需求调研记录表 & 场景描述、当前流程、主要痛点、可接入数据、预期指标、风险边界      \\
		\bottomrule
	\end{tabularx}
\end{table}

\begin{table}[H]
	\centering
	\caption{测试与评估模板}
	\begin{tabularx}{\textwidth}{L{3.2cm}Y}
		\toprule
		模板名称    & 字段说明                           \\
		\midrule
		测试指标定义表 & 指标名称、定义方式、采样频率、目标值、说明          \\
		试点评估表   & 试点场景、试点周期、使用人数、主要成效、问题清单、下一步计划 \\
		真实性核验表  & 正文结论、对应附件编号、材料状态、核验结果、备注       \\
		版本迭代记录表 & 版本编号、更新时间、改动内容、测试结果、截图索引       \\
		\bottomrule
	\end{tabularx}
\end{table}

\section{问卷与访谈记录示例}

\begin{table}[H]
	\centering
	\caption{问卷样本统计表示例}
	\begin{tabularx}{\textwidth}{L{1.8cm}L{2.4cm}L{2.4cm}Y}
		\toprule
		样本编号 & 对象类型    & 场景属性 & 关键记录字段                       \\
		\midrule
		Q-01 & 政府管理者   & 基层治理 & 当前信息来源、最常见舆情类型、现有处置链路、期望预警时效 \\
		Q-02 & 热线协同人员  & 民生服务 & 高频投诉主题、重复工单占比、人工汇总痛点、数据协同难点  \\
		Q-03 & 景区运营人员  & 文旅服务 & 节假日投诉峰值、热点渠道、负面评论处置周期、服务改进需求 \\
		Q-04 & 企业品牌负责人 & 品牌公关 & 品牌监测频率、重点平台、舆情升级阈值、预算敏感度     \\
		Q-05 & 校园管理人员  & 校园治理 & 校园热点来源、值班流程、跨部门协同难点、风险偏好     \\
		Q-06 & 一线执行人员  & 日常运维 & 报表需求、预警接收方式、误报容忍度、培训需求       \\
		Q-07 & 合作伙伴    & 渠道协同 & 客户来源类型、方案互补点、交付边界、项目分工       \\
		Q-08 & 专家或导师   & 综合评估 & 场景适配性、技术可信性、商业逻辑、方案表达        \\
		\bottomrule
	\end{tabularx}
\end{table}

\begin{table}[H]
	\centering
	\caption{访谈对象摘要表示例}
	\begin{tabularx}{\textwidth}{L{1.8cm}L{2.6cm}Y L{2.0cm}}
		\toprule
		访谈编号 & 访谈对象      & 记录内容                          & 材料状态 \\
		\midrule
		I-01 & 地方治理条线负责人 & 当前问题识别流程、需要什么样的预警和报告、对部署模式的偏好 & 补充中  \\
		I-02 & 景区运营经理    & 投诉来源、旺季热点、跨平台信息汇总困难点、应急响应要求   & 补充中  \\
		I-03 & 学校宣传或学工人员 & 校园热点管理场景、值守机制、误报容忍度与报告偏好      & 补充中  \\
		I-04 & 企业公关负责人   & 品牌监测频率、风险判断逻辑、预算上限与采购周期       & 补充中  \\
		I-05 & 技术导师或专家   & AI 能力边界、系统稳定性要求、合规提示与优化建议     & 补充中  \\
		\bottomrule
	\end{tabularx}
\end{table}

\section{测试与试点评估示例}

\begin{table}[H]
	\centering
	\caption{测试指标定义表示例}
	\begin{tabularx}{\textwidth}{L{2.4cm}L{2.6cm}Y}
		\toprule
		指标类别 & 指标名称    & 定义说明                    \\
		\midrule
		识别质量 & 分类可用率   & 系统输出可被人工直接采用的分类结果占比     \\
		识别质量 & 情绪识别准确度 & 经人工复核后与真实情绪倾向一致的比例      \\
		预警效率 & 预警生成时长  & 从原始信息进入系统到生成预警的平均时间     \\
		协同效率 & 分派完成时长  & 从问题确认到责任分派完成的平均时间       \\
		稳定性  & 报告生成成功率 & 系统在规定时间内成功生成日报周报专题报告的比例 \\
		经济性  & 人工工时节约率 & 使用系统后与原人工流程相比节约的工时比例    \\
		满意度  & 用户打分    & 使用人员对可用性、可理解性和价值感的综合评分  \\
		\bottomrule
	\end{tabularx}
\end{table}

\begin{table}[H]
	\centering
	\caption{试点评估表示例}
	\begin{tabularx}{\textwidth}{L{1.8cm}L{2.3cm}Y L{2.4cm}}
		\toprule
		试点编号 & 试点场景 & 重点评估项                  & 输出物      \\
		\midrule
		P-01 & 景区文旅 & 热点识别及时性、投诉聚类效果、节假日报告质量 & 试点总结报告   \\
		P-02 & 校园治理 & 热点事件识别、跨部门协同、值班效率改善    & 校园专题复盘   \\
		P-03 & 民生协同 & 重复投诉识别、事件分级、责任分派效率     & 闭环改进方案   \\
		P-04 & 企业品牌 & 舆情发现速度、品牌风险标签准确度、报告可读性 & 品牌月报与复盘表 \\
		\bottomrule
	\end{tabularx}
\end{table}

\section{真实性核验清单}

\begin{table}[H]
	\centering
	\caption{真实性核验清单示例}
	\begin{tabularx}{\textwidth}{L{4cm}L{3cm}Y}
		\toprule
		正文关键结论        & 对应材料类型              & 核验要求                 \\
		\midrule
		项目具备完整商业计划书工程 & PDF 成稿、LaTeX 目录截图   & 核验目录完整、章节可编译、页码连续    \\
		项目具备原型与界面基础   & 系统截图、录屏、交互稿         & 核验界面真实存在，避免只保留静态概念图  \\
		项目做过用户需求调研    & 问卷统计、访谈纪要           & 核验样本来源、时间、结论摘要和局限性说明 \\
		项目具备试点推进基础    & 会议纪要、需求确认单、意向材料     & 核验沟通对象、场景边界和推进状态     \\
		项目财务测算有推导逻辑   & 测算底表、参数说明、敏感性分析表    & 核验关键参数来源与口径说明是否一致    \\
		团队能力表述可信      & 成员分工说明、作品截图、奖项或证明材料 & 核验成员职责与已承担工作是否匹配     \\
		社会价值不是空泛口号    & 指标设计表、试点评估表、用户反馈    & 核验价值表达是否能落到可衡量结果     \\
		风险控制机制可执行     & 风险矩阵、权限与复核机制说明      & 核验风险是否有明确责任人与应对动作    \\
		\bottomrule
	\end{tabularx}
\end{table}
