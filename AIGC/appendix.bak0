\section{测试与评估模板}

\begin{table}[htbp]
\t\centering
\t\caption{测试与评估模板}
\t\begin{tabularx}{\textwidth}{|L{3.2cm}Y|}
\t\t\hline
\t\t\tblhead{模板名称} & \tblhead{字段说明} \\
\t\t\hline
\t\t\rowcolors{2}{tablealt}{white}
\t\t测试指标定义表 & 指标名称、定义方式、采样频率、目标值、说明 \\
\t\t试点评估表 & 试点场景、试点周期、使用人数、主要成效、问题清单、下一步计划 \\
\t\t真实性核验表 & 正文结论、对应附件编号、材料状态、核验结果、备注 \\
\t\t版本迭代记录表 & 版本编号、更新时间、改动内容、测试结果、截图索引 \\
\t\t\hline
\t\end{tabularx}
\end{table}

\section{真实性核验清单}

\begin{table}[htbp]
\t\centering
\t\caption{真实性核验清单示例}
\t\begin{tabularx}{\textwidth}{|L{4cm}L{3cm}Y|}
\t\t\hline
\t\t\tblhead{正文关键结论} & \tblhead{对应材料类型} & \tblhead{核验要求} \\
\t\t\hline
\t\t\rowcolors{2}{tablealt}{white}
\t\t项目具备完整商业计划书工程 & PDF 成稿、LaTeX 目录截图 & 核验目录完整、章节可编译、页码连续 \\
\t\t项目具备原型与界面基础 & 系统截图、录屏、交互稿 & 核验界面真实存在，避免只保留静态概念图 \\
\t\t项目具备试点推进基础 & 会议纪要、需求确认单、意向材料 & 核验沟通对象、场景边界和推进状态 \\
\t\t项目财务测算有推导逻辑 & 测算底表、参数说明、敏感性分析表 & 核验关键参数来源与口径说明是否一致 \\
\t\t团队能力表述可信 & 成员分工说明、作品截图、奖项或证明材料 & 核验成员职责与已承担工作是否匹配 \\
\t\t社会价值不是空泛口号 & 指标设计表、试点评估表、用户反馈 & 核验价值表达是否能落到可衡量结果 \\
\t\t风险控制机制可执行 & 风险矩阵、权限与复核机制说明 & 核验风险是否有明确责任人与应对动作 \\
\t\t\hline
\t\end{tabularx}
\end{table}
